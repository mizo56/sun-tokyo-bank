
const SUPABASE_URL = process.env.SUPABASE_URL;
const SUPABASE_SECRET_KEY = process.env.SUPABASE_SECRET_KEY;

export default async function handler(req, res) {

  if (req.method !== "POST") {
    return res.status(405).json({
      success: false,
      message: "Method Not Allowed"
    });
  }

  try {

    if (!SUPABASE_URL || !SUPABASE_SECRET_KEY) {
      return res.status(500).json({
        success: false,
        message: "إعدادات Supabase غير موجودة في Vercel"
      });
    }

    const {
      userId,
      username,
      action,
      productId
    } = req.body || {};

    if (!userId && !username) {
      return res.status(400).json({
        success: false,
        message: "بيانات المستخدم ناقصة"
      });
    }

    const headers = {
      "apikey": SUPABASE_SECRET_KEY,
      "Authorization": `Bearer ${SUPABASE_SECRET_KEY}`,
      "Content-Type": "application/json"
    };


    // =====================================================
    // استخدام المنتج
    // =====================================================

    if (action === "use") {

      if (!productId) {
        return res.status(400).json({
          success: false,
          message: "رقم المنتج غير موجود"
        });
      }

      let userQuery;

      if (userId) {
        userQuery =
          `${SUPABASE_URL}/rest/v1/users?id=eq.${encodeURIComponent(userId)}&select=id,username,balance`;
      } else {
        userQuery =
          `${SUPABASE_URL}/rest/v1/users?username=eq.${encodeURIComponent(String(username).trim())}&select=id,username,balance`;
      }

      const userResponse = await fetch(
        userQuery,
        {
          method: "GET",
          headers
        }
      );

      const users = await userResponse.json();

      if (!userResponse.ok || !Array.isArray(users) || !users.length) {
        return res.status(404).json({
          success: false,
          message: "المستخدم غير موجود"
        });
      }

      const user = users[0];


      // جلب المنتج من المخزون
      const inventoryResponse = await fetch(
        `${SUPABASE_URL}/rest/v1/inventory?user_id=eq.${encodeURIComponent(user.id)}&product_id=eq.${encodeURIComponent(productId)}&select=*`,
        {
          method: "GET",
          headers
        }
      );

      const inventoryItems = await inventoryResponse.json();

      if (
        !inventoryResponse.ok ||
        !Array.isArray(inventoryItems) ||
        !inventoryItems.length
      ) {
        return res.status(404).json({
          success: false,
          message: "❌ هذا المنتج غير موجود في المخزون"
        });
      }

      const inventoryItem = inventoryItems[0];

      const quantity =
        Number(
          inventoryItem.quantity ||
          inventoryItem.count ||
          0
        );

      if (quantity <= 0) {
        return res.status(400).json({
          success: false,
          message: "❌ لا توجد كمية من هذا المنتج"
        });
      }


      // إنقاص الكمية
      if (quantity > 1) {

        const updateInventory = await fetch(
          `${SUPABASE_URL}/rest/v1/inventory?id=eq.${encodeURIComponent(inventoryItem.id)}`,
          {
            method: "PATCH",
            headers: {
              ...headers,
              "Prefer": "return=representation"
            },
            body: JSON.stringify({
              quantity: quantity - 1
            })
          }
        );

        if (!updateInventory.ok) {
          return res.status(500).json({
            success: false,
            message: "تعذر تحديث المخزون"
          });
        }

      } else {

        const deleteInventory = await fetch(
          `${SUPABASE_URL}/rest/v1/inventory?id=eq.${encodeURIComponent(inventoryItem.id)}`,
          {
            method: "DELETE",
            headers
          }
        );

        if (!deleteInventory.ok) {
          return res.status(500).json({
            success: false,
            message: "تعذر حذف المنتج من المخزون"
          });
        }

      }


      return res.status(200).json({
        success: true,
        message: `✅ تم استخدام ${inventoryItem.product_name || inventoryItem.productName || "المنتج"}`,
        user: {
          id: user.id,
          username: user.username,
          balance: Number(user.balance || 0)
        }
      });

    }


    // =====================================================
    // عرض المخزون
    // =====================================================

    let userQuery;

    if (userId) {

      userQuery =
        `${SUPABASE_URL}/rest/v1/users?id=eq.${encodeURIComponent(userId)}&select=id,username,balance`;

    } else {

      userQuery =
        `${SUPABASE_URL}/rest/v1/users?username=eq.${encodeURIComponent(String(username).trim())}&select=id,username,balance`;

    }


    const userResponse = await fetch(
      userQuery,
      {
        method: "GET",
        headers
      }
    );

    const users = await userResponse.json();

    if (
      !userResponse.ok ||
      !Array.isArray(users) ||
      !users.length
    ) {
      return res.status(404).json({
        success: false,
        message: "المستخدم غير موجود"
      });
    }

    const user = users[0];


    // جلب المخزون
    const inventoryResponse = await fetch(
      `${SUPABASE_URL}/rest/v1/inventory?user_id=eq.${encodeURIComponent(user.id)}&select=*`,
      {
        method: "GET",
        headers
      }
    );

    const inventoryText = await inventoryResponse.text();

    if (!inventoryResponse.ok) {

      console.error(
        "Supabase inventory error:",
        inventoryText
      );

      return res.status(500).json({
        success: false,
        message: "تعذر تحميل المخزون"
      });

    }

    let items = [];

    try {
      items = JSON.parse(inventoryText);
    } catch {
      items = [];
    }


    return res.status(200).json({

      success: true,

      user: {
        id: user.id,
        username: user.username,
        balance: Number(user.balance || 0)
      },

      items: Array.isArray(items)
        ? items
        : []

    });

  } catch (error) {

    console.error(
      "Inventory error:",
      error
    );

    return res.status(500).json({
      success: false,
      message: "❌ حدث خطأ في الخادم"
    });

  }

}
