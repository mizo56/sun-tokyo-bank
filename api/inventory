const SUPABASE_URL = process.env.SUPABASE_URL;
const SUPABASE_SECRET_KEY = process.env.SUPABASE_SECRET_KEY;

export default async function handler(req, res) {
  res.setHeader("Content-Type", "application/json; charset=utf-8");

  if (req.method !== "POST") {
    return res.status(405).json({
      success: false,
      message: "Method Not Allowed"
    });
  }

  try {
    if (!SUPABASE_URL || !SUPABASE_SECRET_KEY) {
      return res.status(500).json({
        success: false,
        message: "إعدادات Supabase غير موجودة في Vercel"
      });
    }

    const body = req.body || {};

    const username = String(body.username || "").trim();
    const userId = body.userId;
    const action = body.action || "list";
    const productId = body.productId;

    if (!username && !userId) {
      return res.status(400).json({
        success: false,
        message: "بيانات المستخدم ناقصة"
      });
    }

    const headers = {
      apikey: SUPABASE_SECRET_KEY,
      Authorization: `Bearer ${SUPABASE_SECRET_KEY}`,
      "Content-Type": "application/json"
    };

    /*
     * =====================================================
     * استخدام منتج
     * =====================================================
     */

    if (action === "use") {
      if (!productId) {
        return res.status(400).json({
          success: false,
          message: "معرف المنتج غير موجود"
        });
      }

      const inventoryResponse = await fetch(
        `${SUPABASE_URL}/rest/v1/inventory?id=eq.${encodeURIComponent(productId)}&select=*`,
        {
          method: "GET",
          headers
        }
      );

      const inventoryText = await inventoryResponse.text();

      if (!inventoryResponse.ok) {
        console.error("Inventory lookup error:", inventoryText);

        return res.status(500).json({
          success: false,
          message: "تعذر الوصول إلى المخزون"
        });
      }

      let items;

      try {
        items = JSON.parse(inventoryText);
      } catch {
        return res.status(500).json({
          success: false,
          message: "استجابة غير صحيحة من قاعدة البيانات"
        });
      }

      if (!Array.isArray(items) || items.length === 0) {
        return res.status(404).json({
          success: false,
          message: "المنتج غير موجود في المخزون"
        });
      }

      const item = items[0];

      const quantity = Number(item.quantity || 0);

      if (quantity <= 0) {
        return res.status(400).json({
          success: false,
          message: "لا توجد كمية من هذا المنتج"
        });
      }

      /*
       * إذا كانت الكمية أكثر من 1 ننقص واحدة.
       * وإذا كانت 1 نحذف العنصر.
       */

      if (quantity > 1) {
        const updateResponse = await fetch(
          `${SUPABASE_URL}/rest/v1/inventory?id=eq.${encodeURIComponent(item.id)}`,
          {
            method: "PATCH",
            headers: {
              ...headers,
              Prefer: "return=representation"
            },
            body: JSON.stringify({
              quantity: quantity - 1
            })
          }
        );

        const updateText = await updateResponse.text();

        if (!updateResponse.ok) {
          console.error("Inventory update error:", updateText);

          return res.status(500).json({
            success: false,
            message: "تعذر استخدام المنتج"
          });
        }
      } else {
        const deleteResponse = await fetch(
          `${SUPABASE_URL}/rest/v1/inventory?id=eq.${encodeURIComponent(item.id)}`,
          {
            method: "DELETE",
            headers
          }
        );

        const deleteText = await deleteResponse.text();

        if (!deleteResponse.ok) {
          console.error("Inventory delete error:", deleteText);

          return res.status(500).json({
            success: false,
            message: "تعذر إزالة المنتج من المخزون"
          });
        }
      }

      return res.status(200).json({
        success: true,
        message: `✅ تم استخدام ${item.item_name || "المنتج"}`
      });
    }

    /*
     * =====================================================
     * عرض المخزون
     * =====================================================
     */

    let query;

    if (userId !== undefined && userId !== null && userId !== "") {
      query =
        `${SUPABASE_URL}/rest/v1/inventory` +
        `?user_id=eq.${encodeURIComponent(userId)}` +
        `&select=id,user_id,item_name,item_type,quantity,created_at` +
        `&order=created_at.desc`;
    } else {
      return res.status(400).json({
        success: false,
        message: "معرف المستخدم غير موجود"
      });
    }

    const response = await fetch(query, {
      method: "GET",
      headers
    });

    const text = await response.text();

    if (!response.ok) {
      console.error("Supabase inventory error:", text);

      return res.status(500).json({
        success: false,
        message: "تعذر الوصول إلى المخزون"
      });
    }

    let inventory;

    try {
      inventory = JSON.parse(text);
    } catch {
      console.error("Invalid Supabase JSON:", text);

      return res.status(500).json({
        success: false,
        message: "استجابة غير صحيحة من قاعدة البيانات"
      });
    }

    if (!Array.isArray(inventory)) {
      inventory = [];
    }

    /*
     * توحيد أسماء البيانات التي يفهمها index.html
     */

    const items = inventory.map(item => ({
      id: item.id,
      user_id: item.user_id,
      product_id: item.id,
      productId: item.id,
      item_name: item.item_name,
      productName: item.item_name,
      name: item.item_name,
      item_type: item.item_type,
      quantity: Number(item.quantity || 0),
      count: Number(item.quantity || 0),
      icon: getIcon(item.item_type, item.item_name),
      created_at: item.created_at
    }));

    return res.status(200).json({
      success: true,
      items,
      inventory: items
    });

  } catch (error) {
    console.error("Inventory API error:", error);

    return res.status(500).json({
      success: false,
      message: "❌ حدث خطأ في API المخزون"
    });
  }
}


/*
 * =====================================================
 * أيقونة المنتج
 * =====================================================
 */

function getIcon(type, name) {
  const text = `${type || ""} ${name || ""}`.toLowerCase();

  if (text.includes("سيف")) return "⚔️";
  if (text.includes("درع")) return "🛡️";
  if (text.includes("خاتم")) return "💍";
  if (text.includes("تاج")) return "👑";
  if (text.includes("جوهرة")) return "💎";
  if (text.includes("جرعة")) return "🧪";
  if (text.includes("كتاب")) return "📖";
  if (text.includes("قوس")) return "🏹";
  if (text.includes("رمح")) return "🔱";
  if (text.includes("طعام")) return "🍱";
  if (text.includes("هدية")) return "🎁";

  return "📦";
}
